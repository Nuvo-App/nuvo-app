{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Nuvo – Web Preview",
      "request": "launch",
      "type": "dart",
      "args": [
        "-d",
        "web-server",
        "--web-hostname",
        "0.0.0.0",
        "--web-port",
        "8080"
      ]
    },
    {
      "name": "Nuvo – Dev API",
      "request": "launch",
      "type": "dart",
      "args": [
        "--dart-define=NUVO_API_BASE_URL=https://nuvo-api-dev.getnuvoapp.workers.dev"
      ]
    }
  ]
}
