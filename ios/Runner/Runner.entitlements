<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!--
	  Universal links for Nuvo invite URLs (https://<host>/j/<token>).
	  REQUIRES the "Associated Domains" capability to be enabled for the App ID
	  (net.getnuvo.app) in the Apple Developer portal before a signed build will
	  accept this entitlement. Custom-scheme links (nuvo://j/<token>) work today
	  without the portal step. See docs/agents/19-social-platform-contract.md.
	-->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:nuvo-api.getnuvoapp.workers.dev</string>
	</array>
	<!--
	  Push notifications. aps-environment MUST be declared or iOS never hands
	  the app an APNs token, so no push token is ever registered (the app was
	  shipped without it: 41 users, 0 device tokens). 'development' is the
	  Xcode default; App Store / TestFlight archives are re-signed with the
	  distribution profile's 'production' value automatically.
	  Requires the Push Notifications capability on App ID net.getnuvo.app
	  in the Apple Developer portal.
	-->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
