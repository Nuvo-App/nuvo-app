{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nuvo Motion Analysis Request",
  "type": "object",
  "required": ["schemaVersion", "motionId", "frames"],
  "properties": {
    "schemaVersion": {"const": 1},
    "motionId": {"type": "string", "minLength": 1},
    "targetReps": {"type": "integer", "minimum": 1},
    "durationMs": {"type": "integer", "minimum": 0},
    "frames": {"type": "array", "minItems": 2, "maxItems": 900}
  }
}
